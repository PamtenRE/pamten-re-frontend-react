{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "dynamicRoutes": [
    {
      "page": "/recruiter/applications/[id]",
      "regex": "^/recruiter/applications/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/recruiter/applications/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/recruiter/candidates/[id]",
      "regex": "^/recruiter/candidates/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/recruiter/candidates/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/recruiter/requisitions/[id]",
      "regex": "^/recruiter/requisitions/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/recruiter/requisitions/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/recruiter/requisitions/[id]/applications",
      "regex": "^/recruiter/requisitions/([^/]+?)/applications(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/recruiter/requisitions/(?<nxtPid>[^/]+?)/applications(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/candidate/dashboard",
      "regex": "^/candidate/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/candidate/dashboard(?:/)?$"
    },
    {
      "page": "/candidate/profile",
      "regex": "^/candidate/profile(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/candidate/profile(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/recruiter/applications",
      "regex": "^/recruiter/applications(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/recruiter/applications(?:/)?$"
    },
    {
      "page": "/recruiter/candidates",
      "regex": "^/recruiter/candidates(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/recruiter/candidates(?:/)?$"
    },
    {
      "page": "/recruiter/dashboard",
      "regex": "^/recruiter/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/recruiter/dashboard(?:/)?$"
    },
    {
      "page": "/recruiter/job-post",
      "regex": "^/recruiter/job\\-post(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/recruiter/job\\-post(?:/)?$"
    },
    {
      "page": "/recruiter/profile",
      "regex": "^/recruiter/profile(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/recruiter/profile(?:/)?$"
    },
    {
      "page": "/recruiter/requisitions",
      "regex": "^/recruiter/requisitions(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/recruiter/requisitions(?:/)?$"
    },
    {
      "page": "/recruiter/requisitions/new",
      "regex": "^/recruiter/requisitions/new(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/recruiter/requisitions/new(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "RSC",
    "varyHeader": "RSC, Next-Router-State-Tree, Next-Router-Prefetch, Next-Router-Segment-Prefetch",
    "prefetchHeader": "Next-Router-Prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "Next-Router-Segment-Prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  },
  "rewrites": []
}